# Allow init.insmod.sh to read cmdline
allow init_insmod_sh proc_cmdline:file r_file_perms;

# Allow required capabilities for modprobe
allow init_insmod_sh self:capability sys_nice;
allow init_insmod_sh kernel:process setsched;

#AxionAOSP
#allow init proc_vm_dirty:file rw_file_perms;
#allow init proc_dirty_ratio:file rw_file_perms;
# Allow init to write the input_suspend node for bypass charge feature
#allow init battery_input_suspend_file:file rw_file_perms;
